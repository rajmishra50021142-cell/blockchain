# Root Environment Reference (Digital Document Locker)

# 1. Blockchain Deployer Configuration (Sepolia)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_DEPLOYER_PRIVATE_KEY=YOUR_SEPOLIA_DEPLOYER_PRIVATE_KEY

# 2. Local Hardhat Configuration
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# 3. Smart Contract Addresses (Sepolia or Local)
CONTRACT_DOCUMENT_REGISTRY=
CONTRACT_ACCESS_CONTROL=
CONTRACT_NETWORK=sepolia

# 4. Backend Server Configuration
PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://your-frontend.vercel.app
AUTH_JWT_SECRET=YOUR_64_CHARACTER_RANDOM_HEX_SECRET

# 5. Pinata IPFS Credentials (Server-side)
IPFS_API_URL=https://uploads.pinata.cloud/v3/files
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
IPFS_JWT=YOUR_PINATA_API_JWT_TOKEN
