# Backend Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Authentication (Cryptographically secure random secret generated locally)
AUTH_JWT_SECRET=
JWT_EXPIRES_IN=1h

# Blockchain RPC Configuration
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Smart Contract Addresses (Populated from Phase 5 and Phase 6 deployments)
CONTRACT_DOCUMENT_REGISTRY=
CONTRACT_ACCESS_CONTROL=

# Pinata / IPFS Configuration (Server-side only)
IPFS_API_URL=https://uploads.pinata.cloud/v3/files
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
IPFS_JWT=
