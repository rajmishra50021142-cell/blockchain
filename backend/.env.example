# Backend Server Configuration
PORT=3001
NODE_ENV=production
# In production, specify your Vercel deployment URL(s), comma-separated if needed:
CORS_ORIGIN=https://your-frontend.vercel.app

# Authentication (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_JWT_SECRET=YOUR_64_CHARACTER_RANDOM_HEX_SECRET
AUTH_JWT_EXPIRES_IN=15m
AUTH_CHALLENGE_TTL_SECONDS=300

# Blockchain RPC Configuration
# Local: RPC_URL=http://127.0.0.1:8545, CHAIN_ID=31337
# Sepolia:
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CHAIN_ID=11155111
CONTRACT_NETWORK=sepolia

# Smart Contract Addresses (Deployed on Sepolia)
CONTRACT_DOCUMENT_REGISTRY=YOUR_SEPOLIA_DOCUMENT_REGISTRY_ADDRESS
CONTRACT_ACCESS_CONTROL=YOUR_SEPOLIA_ACCESS_CONTROL_ADDRESS

# Pinata / IPFS Configuration (Server-side relay)
IPFS_API_URL=https://uploads.pinata.cloud/v3/files
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
IPFS_JWT=YOUR_PINATA_API_JWT_TOKEN
